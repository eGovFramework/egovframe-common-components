<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
		http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-4.0.xsd">

	<!-- 삭제된 context-crypto.xml 대신 crypto 라이브러리를 직접 스캔 (egovPasswordResolver 제공) -->
	<context:component-scan base-package="org.egovframe.rte.fdl.crypto" />
	<bean id="egovPasswordResolver" class="egovframework.com.cmm.util.EgovPasswordResolver" />

	<import
		resource="classpath*:/egovframework/spring/com/context-datasource.xml" />
	<import
		resource="classpath*:/egovframework/spring/com/context-mapper.xml" />
	<import
		resource="classpath*:/egovframework/spring/com/context-transaction.xml" />
		
	<import
		resource="classpath*:/egovframework/spring/com/test-context-common.xml" />

</beans>
